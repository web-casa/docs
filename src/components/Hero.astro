---
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const { lang } = Astro.locals.starlightRoute;

const screenshotSrc = lang === 'zh-CN' ? '/docs/screenshot-zh.png' : '/docs/screenshot-en.png';

const stats = [
  { value: 'AI', label: 'Native' },
  { value: '44', label: 'MCP Tools' },
  { value: '13', label: 'Plugins' },
  { value: 'MIT', label: 'License' },
];
---

<div class="hero-wrapper">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero">
    <img src={screenshotSrc} alt="Web.Casa Dashboard" loading="eager" decoding="async" class="hero-screenshot" />
    <div class="sl-flex stack">
      <div class="sl-flex copy">
        <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
        {tagline && <div class="tagline" set:html={tagline} />}
      </div>
      {
        actions.length > 0 && (
          <div class="sl-flex actions">
            {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <a href={href} class:list={['action', variant, className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </a>
            ))}
          </div>
        )
      }
      <div class="hero-stats">
        {stats.map((stat) => (
          <div class="stat-badge">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  @layer starlight.custom {
    .hero-wrapper {
      position: relative;
      overflow: hidden;
    }

    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse at 20% 50%, oklch(0.55 0.17 160 / 0.08) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, oklch(0.55 0.17 160 / 0.06) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 80%, oklch(0.45 0.12 160 / 0.05) 0%, transparent 55%);
    }

    :global([data-theme='dark']) .hero-bg {
      background:
        radial-gradient(ellipse at 20% 50%, oklch(0.45 0.15 160 / 0.12) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, oklch(0.45 0.15 160 / 0.08) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 80%, oklch(0.35 0.1 160 / 0.07) 0%, transparent 55%);
    }

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
      padding-block: clamp(2rem, calc(1rem + 8vmin), 5rem) clamp(1.5rem, calc(1rem + 4vmin), 3rem);
    }

    .hero-screenshot {
      width: min(100%, 56rem);
      height: auto;
      margin-inline: auto;
      order: 2;
    }


    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > h1 {
      font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .tagline {
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
      color: var(--sl-color-gray-2);
    }

    .actions {
      gap: 1rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .action {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      border-radius: 999px;
      font-weight: 500;
      text-decoration: none;
      font-size: var(--sl-text-base);
      transition: background 0.2s, color 0.2s;
    }

    .action.primary {
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
    }

    .action.primary:hover {
      opacity: 0.9;
    }

    .action.secondary,
    .action.minimal {
      border: 1px solid var(--sl-color-gray-5);
      color: var(--sl-color-white);
    }

    .action.secondary:hover,
    .action.minimal:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-accent);
    }

    .hero-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin-block-start: 0.5rem;
    }

    .stat-badge {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--sl-color-gray-5);
      background: var(--sl-color-gray-7, oklch(0.25 0 0 / 0.5));
      font-size: var(--sl-text-sm);
      line-height: 1;
      transition: border-color 0.2s;
    }

    .stat-badge:hover {
      border-color: var(--sl-color-accent);
    }

    .stat-value {
      font-weight: 700;
      color: var(--sl-color-accent);
    }

    .stat-label {
      color: var(--sl-color-gray-2);
    }

    @media (min-width: 50rem) {
      .hero-screenshot {
        width: min(100%, 56rem);
      }
    }
  }
</style>
